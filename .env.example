# ==========================================
# LegalAI Platform Environment Configuration
# ==========================================

# Application
PROJECT_NAME="LegalAI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development):
DATABASE_URL="sqlite:///./legalai.db"
# For PostgreSQL (production / docker):
# DATABASE_URL="postgresql://legalai:legalai_secret@localhost:5432/legalai_db"

# LLM Provider Configuration
# Supported providers: "openai", "gemini", "anthropic", "demo"
LLM_PROVIDER="demo"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# Embeddings & Vector Search
EMBEDDING_MODEL="all-MiniLM-L6-v2"
VECTOR_STORE_DIR="./data/vector_store"
DOCUMENT_UPLOAD_DIR="./data/uploads"

# CORS Configuration (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Admin Initial Seed
FIRST_SUPERUSER_EMAIL="admin@legalai.in"
FIRST_SUPERUSER_PASSWORD="AdminSecurePassword123!"
